# Copy these names into a local, gitignored .env.local; fill values privately.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3100
CRON_SECRET=
# Server-only. Supabase dashboard -> Connect -> Session pooler -> copy the URI and
# replace [YOUR-PASSWORD]. Used only by npm run db:plan / db:migrate. Never expose it.
DATABASE_URL=
# Only for one-time bootstrap:
BOOTSTRAP_USER_ID=

# Outbound transactional email. Not required for sign-in; required for invitations,
# confirmations and password recovery. Values live only in .env.local and the host.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Optional: change the --send test recipient away from the sender address.
SMTP_TEST_TO=
