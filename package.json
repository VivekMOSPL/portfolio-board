{
  "name": "portfolio-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/database.test.mjs tests/domain.test.ts tests/workbooks.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check:ready": "node --env-file=.env.local scripts/check-ready.mjs",
    "db:plan": "node --env-file=.env.local scripts/apply-migrations.mjs --dry-run",
    "db:migrate": "node --env-file=.env.local scripts/apply-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
